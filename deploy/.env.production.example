# Salin ke .env.production (jangan di-commit) dan isi nilai sebenarnya. Nilai di bawah hanya contoh palsu.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/sa_visit_tracker
# Acak, minimal 32 karakter (mis. `openssl rand -base64 48`). Jangan pakai nilai dari aplikasi lain.
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG_MINIMAL_32_KARAKTER
# Alamat HTTPS frontend persis (dipakai CORS dan perlindungan CSRF)
CORS_ORIGIN=https://visit-tracker.contoh.skolla.id
# Folder foto di server (di-mount ke container, ikut di-backup). Beri hak tulis ke uid 1000: chown 1000:1000
PHOTO_HOST_DIR=/srv/sa-visit/photos
